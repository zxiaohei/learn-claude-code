#!/bin/bash
# Run a lesson with the project's own Python environment.
set -euo pipefail

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT"

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
    cat <<'HELP'
用法：
  ./run                         运行第一章
  ./run s08                     运行第八章
  ./run s01_agent_loop/code.py   运行指定 Python 文件
  ./run 路径.py 参数...          将参数传给 Python 文件

首次运行会创建 .venv 并安装依赖，后续直接复用，无需手动激活。
需要已安装 Python 3.10+，推荐与项目测试环境一致的 Python 3.11。
HELP
    exit 0
fi

target="${1:-s01}"
if (( $# > 0 )); then
    shift
fi
if [[ "$target" =~ ^s[0-9]{2}$ ]]; then
    matches=("$ROOT"/"${target}"_*/code.py)
    if [[ ${#matches[@]} -ne 1 || ! -f "${matches[0]}" ]]; then
        echo "找不到唯一对应的课程：${target}。可使用 ./run --help 查看用法。" >&2
        exit 1
    fi
    target="${matches[0]}"
fi
if [[ "$target" != *.py || ! -f "$target" ]]; then
    echo "找不到 Python 文件：$target" >&2
    exit 1
fi

PYTHON="$ROOT/.venv/bin/python"
if [[ ! -e "$ROOT/.venv" ]]; then
    interpreter=""
    for candidate in python3.11 python3 python3.12 python3.13 python3.14 python3.10; do
        if command -v "$candidate" >/dev/null 2>&1 &&
            "$candidate" -c 'import sys; sys.exit(sys.version_info < (3, 10))'; then
            interpreter="$candidate"
            break
        fi
    done
    if [[ -z "$interpreter" ]]; then
        echo "需要 Python 3.10+。使用 Homebrew 的 macOS 可先执行：brew install python@3.11" >&2
        exit 1
    fi
    echo "正在创建项目虚拟环境……"
    "$interpreter" -m venv "$ROOT/.venv"
fi

if [[ ! -x "$PYTHON" ]] ||
    ! "$PYTHON" -c 'import sys; sys.exit(sys.version_info < (3, 10))'; then
    echo "现有 .venv 不可用或 Python 版本低于 3.10，请用 Python 3.11 重新创建。" >&2
    exit 1
fi

if ! cmp -s "$ROOT/requirements.txt" "$ROOT/.venv/.requirements-installed"; then
    echo "正在安装项目依赖……"
    "$PYTHON" -m pip install -r "$ROOT/requirements.txt"
    cp "$ROOT/requirements.txt" "$ROOT/.venv/.requirements-installed"
fi

exec "$PYTHON" "$target" "$@"
